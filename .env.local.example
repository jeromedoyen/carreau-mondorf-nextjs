# Copier en .env.local (déjà ignoré par git) et compléter avec les valeurs
# du projet Supabase (Project Settings > API).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=

# Variables publiques (préfixe obligatoire Next.js) utilisées par l'appli
# elle-même pour lire les données en lecture seule.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Déclaration vocale d'une participation à un concours (03/08/2026).
# Service de transcription (faster-whisper) hébergé sur Render — cf.
# services/notes-vocales/. Le secret est partagé avec ce service, où il
# doit être défini sous le nom TRANSCRIPTION_API_SECRET.
NOTES_VOCALES_URL=https://notes-vocales.onrender.com
NOTES_VOCALES_SECRET=

# Adresse de réponse aux e-mails de clarification : le jeton du dossier
# est inséré en plus-addressing (concours+<jeton>@...), et l'e-mail
# revient par le webhook Resend Inbound. Nécessite un enregistrement MX
# sur ce (sous-)domaine, pointé vers Resend.
CONCOURS_REPLY_TO=concours@concours.carreau-mondorf.com
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Phase de test (03/08/2026) : tant que cette variable est renseignée,
# TOUS les e-mails de la déclaration vocale partent vers cette seule
# adresse au lieu du licencié concerné. La vider rétablit l'envoi normal.
DECLARATION_VOCALE_EMAIL_TEST=

# Transcription des déclarations vocales — Groq (Whisper large-v3-turbo),
# palier gratuit largement suffisant (2 000 requêtes/jour). Clé à créer
# sur https://console.groq.com. Si absente, l'app se rabat sur le service
# auto-hébergé NOTES_VOCALES_* (beaucoup plus lent).
GROQ_API_KEY=
